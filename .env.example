# Seldon environment.
#
# Copy this to `.env` (in the repo root) and fill it in — that one file
# powers the CLI, both services, and `seldon up`. `seldon up` creates `.env`
# from this template on first run if it is missing.

# --- shared ---
LOG_LEVEL=info

# --- Postgres -------------------------------------------------------------
# Seldon does not run a database for you. Bring your own Postgres — a local
# install, Postgres.app, or a hosted provider (Neon, Supabase, ...) — create
# the two databases below, and point these URLs at them:
#
#   createdb psephos          # the synthetic electorate (needs PostGIS)
#   createdb psephos_runs     # the model's run store
#
# `seldon up` connects to both, enables the PostGIS extension on `psephos`,
# and applies migrations. It does not create the databases themselves.
DATABASE_URL=postgres://localhost:5432/psephos
RUNS_DATABASE_URL=postgres://localhost:5432/psephos_runs

# --- services -------------------------------------------------------------
# Ports the two services bind locally. `seldon up` starts them as background
# Bun processes — no Docker.
PSEPHOS_API_PORT=4001
PSEPHOS_MODEL_PORT=4002

# How the CLI and the model reach the services. Defaults to the ports above.
# With portless running you can instead point these at the named URLs
# (https://psephos-api.localhost / https://psephos-model.localhost).
PSEPHOS_API_URL=http://localhost:4001
PSEPHOS_MODEL_URL=http://localhost:4002

# --- seldon CLI: data sources ---------------------------------------------
# Where source definitions and fetched data live. Defaults to <repo>/data.
# SELDON_DATA_DIR=data

# Optional S3 mirror for fetched/processed data (see `seldon data s3`).
# SELDON_S3_BUCKET=seldon-data
# SELDON_S3_REGION=eu-west-2
# SELDON_S3_PREFIX=data
# Custom endpoint for S3-compatible stores (e.g. MinIO); omit for AWS.
# SELDON_S3_ENDPOINT=http://localhost:9000
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
