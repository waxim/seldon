{
  "name": "seldon",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.11",
  "workspaces": [
    "apps/*",
    "packages/*",
    "infra",
    "scripts"
  ],
  "scripts": {
    "check": "turbo run typecheck lint test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "build": "turbo run build",
    "format": "biome format --write .",
    "dev": "bun run scripts/dev.ts",
    "preview": "bun run scripts/preview.ts",
    "deploy": "bun run scripts/deploy.ts",
    "migrate": "bun run scripts/migrate.ts",
    "smoke": "bun run scripts/smoke.ts",
    "infra:up": "bun run scripts/infra-up.ts",
    "infra:check": "bun run scripts/infra-check.ts",
    "gen:wrangler": "bun run scripts/gen-wrangler.ts",
    "deploy:dry-run": "bun run scripts/deploy-dry-run.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.5",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260823.1",
    "@types/bun": "^1.3.11",
    "turbo": "^2.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.44.0",
    "@types/node": "^22.18.6"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
