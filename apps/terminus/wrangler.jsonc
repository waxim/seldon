// apps/terminus/wrangler.jsonc — Terminus.
// the console: the entire UI.
//
// GENERATED by `bun run gen:wrangler` from the resource table in
// @seldon/foundation. Edit that table, not this file: `bun run
// infra:check` fails on drift. Ids come from the synced Pulumi
// stack outputs in infra/outputs/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seldon-terminus-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "dev",
    "BUILD_VERSION": "dev"
  },
  "services": [
    {
      "binding": "DEMERZEL",
      "service": "seldon-demerzel-dev"
    }
  ],
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  "env": {
    "staging": {
      "name": "seldon-terminus-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BUILD_VERSION": "dev"
      },
      "services": [
        {
          "binding": "DEMERZEL",
          "service": "seldon-demerzel-staging"
        }
      ],
      "routes": [
        {
          "pattern": "terminus-staging.seldon.example",
          "custom_domain": true
        }
      ]
    },
    "production": {
      "name": "seldon-terminus-production",
      "vars": {
        "ENVIRONMENT": "production",
        "BUILD_VERSION": "dev"
      },
      "services": [
        {
          "binding": "DEMERZEL",
          "service": "seldon-demerzel-production"
        }
      ],
      "routes": [
        {
          "pattern": "terminus.seldon.example",
          "custom_domain": true
        }
      ]
    }
  }
}
