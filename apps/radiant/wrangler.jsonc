// apps/radiant/wrangler.jsonc — Radiant.
// worlds, the canon replica, epochs, forks, layers, cells, dossiers.
//
// GENERATED by `bun run gen:wrangler` from the resource table in
// @seldon/foundation. Edit that table, not this file: `bun run
// infra:check` fails on drift. Ids come from the synced Pulumi
// stack outputs in infra/outputs/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seldon-radiant-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "dev",
    "BUILD_VERSION": "dev"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "SHARD_DO",
        "class_name": "SeatShard"
      },
      {
        "name": "WORLD_REGISTRY_DO",
        "class_name": "WorldRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["SeatShard", "WorldRegistry"]
    }
  ],
  "d1_databases": [
    {
      "binding": "RADIANT_DB",
      "database_name": "seldon-radiant-db-dev",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "EPOCH_BUCKET",
      "bucket_name": "seldon-epochs-dev"
    },
    {
      "binding": "TILE_BUCKET",
      "bucket_name": "seldon-tiles-dev"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "AGG_KV",
      "id": "local"
    },
    {
      "binding": "TILES_KV",
      "id": "local"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "SYNTH_TASKS_QUEUE",
        "queue": "seldon-synth-tasks-dev"
      }
    ],
    "consumers": [
      {
        "queue": "seldon-synth-tasks-dev",
        "max_batch_size": 1,
        "max_retries": 3,
        "dead_letter_queue": "seldon-synth-tasks-dlq-dev"
      }
    ]
  },
  "workflows": [
    {
      "binding": "SYNTH_WF",
      "name": "seldon-synthesis-dev",
      "class_name": "SynthesisWorkflow"
    }
  ],
  "services": [
    {
      "binding": "VAULT",
      "service": "seldon-vault-dev",
      "entrypoint": "VaultEntrypoint"
    }
  ],
  "env": {
    "staging": {
      "name": "seldon-radiant-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BUILD_VERSION": "dev"
      },
